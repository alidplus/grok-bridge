{
  "name": "grok-bridge",
  "displayName": "Grok Bridge",
  "description": "Unofficial community bridge between Grok Bots and Cursor agents: watch, read and steer Cursor SDK agents from inside Cursor.",
  "version": "0.1.1",
  "publisher": "alidplus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alidplus/grok-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/alidplus/grok-bridge/issues"
  },
  "homepage": "https://github.com/alidplus/grok-bridge#readme",
  "icon": "media/icon.png",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "grok",
    "cursor",
    "agents",
    "sdk"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "grokBridge.open",
        "title": "Grok Bridge: Open"
      },
      {
        "command": "grokBridge.reinstallSdk",
        "title": "Grok Bridge: Reinstall SDK"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grokBridge",
          "title": "Grok Bridge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "grokBridge": [
        {
          "type": "webview",
          "id": "grokBridge.view",
          "name": "Agents"
        }
      ]
    },
    "configuration": {
      "title": "Grok Bridge",
      "properties": {
        "grokBridge.nodePath": {
          "type": "string",
          "default": "",
          "description": "Path to a Node.js >= 22.13 binary used to run the SDK helper. Empty = auto-detect (PATH, nvm, fnm, volta, Homebrew)."
        },
        "grokBridge.sdkDir": {
          "type": "string",
          "default": "",
          "description": "Optional override: a folder whose node_modules contains @cursor/sdk. Empty = the SDK Grok Bridge installs into its global storage on first use."
        },
        "grokBridge.cwd": {
          "type": "string",
          "default": "",
          "description": "Optional override for the agents' working directory. Empty = first workspace folder."
        },
        "grokBridge.defaultModel": {
          "type": "string",
          "default": "grok-4.5",
          "description": "Model id used for new prompts."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package",
    "test:install": "node test/install-sdk.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0"
  }
}
